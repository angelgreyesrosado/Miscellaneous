#!/bin/sh
set -eu

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/prepare-commit-msg.ps1" "$@"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/prepare-commit-msg.ps1" "$@"
else
  echo "No PowerShell runtime found; skipping AI commit message generation." >&2
fi
